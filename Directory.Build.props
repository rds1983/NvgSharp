<Project>
  <PropertyGroup>
    <Authors>NvgSharpTeam</Authors>
    <Product>NvgSharp</Product>
    <PackageLicenseExpression>Zlib</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rds1983/NvgSharp</PackageProjectUrl>
    <RootNamespace>NvgSharp</RootNamespace>
    <Version>0.7.0</Version>
    <MonoGameTargetFramework>netstandard2.0</MonoGameTargetFramework>
    <PATargetFramework>net8.0</PATargetFramework>
    <MonoGameVersion>3.8.0.1641</MonoGameVersion>
    <AppMonoGameVersion>3.8.5</AppMonoGameVersion>
    <FNATargetFramework>net8.0</FNATargetFramework>
    <FontStashSharpVersion>1.5.6</FontStashSharpVersion>
  </PropertyGroup>
</Project>