<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Platform-Agnostic Version of NvgSharp.Text</Description>
    <DefineConstants>$(DefineConstants);PLATFORM_AGNOSTIC</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>   
  
  <ItemGroup>
    <PackageReference Include="FontStashSharp.PlatformAgnostic" Version="$(FontStashSharpVersion)" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\NvgSharp\NvgSharp.PlatformAgnostic.csproj" />
  </ItemGroup>
</Project>
