<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>NvgSharp for MonoGame</Description>
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>
    <OutputPath>bin\MonoGame\$(Configuration)</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>     

  <ItemGroup>
    <Compile Include="..\NvgSharp\**\*.cs" LinkBase="NvgSharp" />
    <Compile Remove="..\NvgSharp\obj\**\*.cs" LinkBase="NvgSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\MonoGameDX11\bin\Effect.efb" />
    <EmbeddedResource Include="Resources\MonoGameDX11\bin\Effect_EDGE_AA.efb" />
    <EmbeddedResource Include="Resources\MonoGameOGL\bin\Effect.efb" />
    <EmbeddedResource Include="Resources\MonoGameOGL\bin\Effect_EDGE_AA.efb" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" PrivateAssets="All" />
  </ItemGroup>
</Project>
